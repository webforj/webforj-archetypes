<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.webforj</groupId>
    <artifactId>webforj-parent</artifactId>
    <version>25.12</version>
  </parent>

  <groupId>com.webforj</groupId>
  <artifactId>webforj-archetypes</artifactId>
  <version>26.03</version>
  <packaging>pom</packaging>

  <name>webforj-archetypes</name>
  <description>webforJ application archetypes</description>

  <properties>
    <webforj.version>${version}</webforj.version>
  </properties>

  <scm>
    <connection>scm:git:git://github.com/webforj/archetypes.git</connection>
    <developerConnection>scm:git:ssh://github.com:webforj/archetypes.git</developerConnection>
    <url>https://github.com/webforj/archetypes/tree/main</url>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/webforj/archetypes/issues</url>
  </issueManagement>

  <modules>
    <module>webforj-archetype-bbj-hello-world</module>
    <module>webforj-archetype-hello-world</module>
    <module>webforj-archetype-blank</module>
    <module>webforj-archetype-tabs</module>
    <module>webforj-archetype-sidemenu</module>
  </modules>

  <repositories>
    <repository>
      <name>Central Portal Snapshots</name>
      <id>central-portal-snapshots</id>
      <url>https://central.sonatype.com/repository/maven-snapshots/</url>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Maven 3.10 writes maven-metadata-local.xml and _remote.repositories into the
             staging repository; releases before 0.12.0 bundle them and Central rejects the
             deployment with "Bundle has content that does NOT have a .pom file". -->
        <plugin>
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <version>0.12.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
